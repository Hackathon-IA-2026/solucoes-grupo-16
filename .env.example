# Docker Compose configuration. Copy this file to .env only when you need to
# override the defaults in compose.yaml.
COMPOSE_PROJECT_NAME=climagrid
FRONTEND_PORT=3000
BACKEND_PORT=3333
AI_SERVICE_PORT=8000

# This address is used by the browser, so it must be reachable from the host.
# Keep it aligned with BACKEND_PORT when changing the published backend port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333
