# Local remains the default until the SQL migration and credentials are ready.
CLIMAGRID_EXPERIMENT_TRACKING=local
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Never use an anon/publishable key or NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Alternative for projects using a legacy service_role JWT:
SUPABASE_SERVICE_ROLE_KEY=
# The experiment bucket is fixed: ml-experiments (private).
# Training CLI: --env-file .env; existing process env takes precedence.
