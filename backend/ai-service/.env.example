# Caminhos são relativos a ai-service/; não há download automático de dados.
CLIMAGRID_ARTIFACT_DIR=artifacts/global/v1
# Snapshot observado consumido pelo replay frontend -> NestJS -> serviço de IA.
CLIMAGRID_HISTORICAL_SNAPSHOT=data/processed/historical/observations.parquet
CLIMAGRID_PLANT_CATALOG=data/processed/reference/plant_locations.parquet
CLIMAGRID_PWF_MAPPING=data/processed/reference/pwf_bus_mapping.parquet
CLIMAGRID_DATA_ROOT=data
# Defina o target somente após validar a semântica ONS:
# CLIMAGRID_TARGET=geracao_referencia_mw
# O cdsapi usa a credencial pessoal configurada fora do repositório.
# Consulte: https://cds.climate.copernicus.eu/how-to-api
