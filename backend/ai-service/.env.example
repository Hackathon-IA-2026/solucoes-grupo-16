# Local remains the default until the SQL migration and credentials are ready.
CLIMAGRID_EXPERIMENT_TRACKING=local
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Never use an anon/publishable key or NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Alternative for projects using a legacy service_role JWT:
SUPABASE_SERVICE_ROLE_KEY=
# The experiment bucket is fixed: ml-experiments (private).
# Training CLI: --env-file .env; existing process env takes precedence.
# Copernicus Climate Data Store. Use o token da sua conta do CDS.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=seu-token-cds

# Caminhos esperados pelos containers local e Render.
CLIMAGRID_DATA_ROOT=/service/data
CLIMAGRID_HISTORICAL_SNAPSHOT=/service/data/processed/historical/observations.parquet
CLIMAGRID_PLANT_CATALOG=/service/data/processed/reference/plant_locations.parquet
CLIMAGRID_PWF_MAPPING=/service/data/processed/reference/pwf_bus_mapping.parquet
# Para repetir o melhor artefato LightGBM servível desta cópia.
CLIMAGRID_ARTIFACT_DIR=/service/artifacts/experiments/multiusina-exp-003
# Relatório somente leitura do challenger DML; não substitui o Predictor.
CLIMAGRID_DML_INSIGHTS_PATH=/service/artifacts/causal/hackathon/insights.json
# Holdout mensal exibido junto aos insights; também não altera o Predictor.
CLIMAGRID_INDEPENDENT_HOLDOUT_PATH=/service/artifacts/causal/independent-holdout-2024-09/holdout_report.json
