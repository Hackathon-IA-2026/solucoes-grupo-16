{
  "target": "geracao_referencia_mw",
  "allow_multiple_plants": true,
  "random_state": 42,
  "n_jobs": 1,
  "features": {
    "rolling_windows_hours": [3, 6],
    "require_complete_history": false,
    "most_enabled": false,
    "most_required": false,
    "most_neutral_length_m": 100000.0
  },
  "lightgbm": {
    "learning_rate": 0.04,
    "n_estimators": 500,
    "num_leaves": 31,
    "min_child_samples": 100,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 5.0
  }
}
