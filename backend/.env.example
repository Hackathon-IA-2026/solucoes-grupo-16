PORT=3333
FRONTEND_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
# PWF_STORAGE_ROOT=/caminho/absoluto/para/dados/pwf

# ── Supabase Configuration ──────────────────────────────────────────────────
# URL do projeto Supabase (ex.: https://xyzproject.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave de API do Supabase (recomenda-se a service_role key para o backend poder
# salvar no storage/banco sem restrições de RLS, ou a anon_key caso tenha políticas liberadas)
SUPABASE_KEY=sua-supabase-service-role-key-ou-anon-key

# Nome do bucket criado no Supabase Storage (padrão: pwf)
SUPABASE_BUCKET=pwf
