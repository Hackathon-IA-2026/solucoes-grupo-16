PORT=3333
FRONTEND_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
# PWF_STORAGE_ROOT=/caminho/absoluto/para/dados/pwf
# PWF_DEFAULT_REFERENCE_ID=uuid-de-um-caso-pwf-ja-validado
# SCENARIO_STORAGE_ROOT=/caminho/absoluto/para/dados/scenarios

# ── Supabase Configuration ──────────────────────────────────────────────────
# URL do projeto Supabase (ex.: https://xyzproject.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Use a service_role key para o backend salvar no bucket privado sem depender
# de políticas abertas. Nunca exponha esta chave no frontend ou em NEXT_PUBLIC_*.
SUPABASE_KEY=sua-supabase-service-role-key

# Nome do bucket criado no Supabase Storage (padrão: pwf)
# No Render Free, ele também persiste climate-scenarios/<uuid>/ e suas exportações.
SUPABASE_BUCKET=pwf
